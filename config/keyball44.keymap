// Layer indices — MOUSE/SCROLL/SNIPE must match the pmw3610 driver
// properties in boards/shields/keyball_nano/keyball44_right.overlay.
#define DEFAULT 0
#define NAV     1
#define SELECT  2
#define SYM     3
#define NUM     4
#define SYS     5
#define MOUSE   6
#define SCROLL  7
#define SNIPE   8

#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>

&nice_view_spi { cs-gpios = <&pro_micro 1 GPIO_ACTIVE_HIGH>; };

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

// Shift lives on the hold of a thumb key (tap = Enter), so "tap-preferred" is
// wrong here: it resolves the hold only when the tapping term expires, which
// means a capital letter has to wait 240ms before it will shift. "balanced"
// resolves the hold as soon as the other key is released, so Shift+letter is
// immediate, while Enter-then-keep-typing rolls still come out as Enter.
&mt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    behaviors {
        tog_on: toggle_layer_on {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        // Bottom-left thumb (the keycap reads "alt"): tap still toggles trackball
        // scroll mode, hold is a real Option/Alt. &mt can't express this — it
        // takes a keycode on both sides, and the tap here is a layer toggle — so
        // this is a hold-tap with &kp on the hold side and &tog on the tap side.
        scroll_alt: scroll_alt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&tog>;
        };

        // Corner key past the trackball: tap right-click, hold Ctrl. Ctrl had no
        // home at all after the port — the corne carried it twice, on a seventh
        // column this board does not have and as the hold of its Enter thumb,
        // and Enter moved to the left thumb here. A tap action and a modifier
        // hold do not compete for the same key, so nothing is given up.
        rclk_ctrl: rclk_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&mkp>;
        };

        // Enter is the tap of the Shift key, so shift+enter cannot be produced by
        // that key alone. It comes off the NUM thumb key next to it instead: with
        // shift held, that key's tap morphs from TAB to shift+enter. The morph
        // masks the physical shift and the morphed binding carries its own, so
        // exactly one shift reaches the host. Shift+TAB is given up here and stays
        // available on the TAB key in the letter block.
        num_tab: num_tab {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <240>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&tab_shift_enter>;
        };

        tab_shift_enter: tab_shift_enter {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&kp LS(ENTER)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // NAV cluster shift variants (mod-morph suppresses the held shift,
        // matching the old Vial key-override behavior)
        nav_up: nav_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp UP>, <&kp PG_UP>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        nav_down: nav_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOWN>, <&kp PG_DN>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        nav_left: nav_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LEFT>, <&kp LC(LEFT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        nav_right: nav_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RIGHT>, <&kp LC(RIGHT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Word-jump keys. The Vial key-overrides carried negative_mod_mask 34,
        // meaning the word-jump was suppressed while shift was held and the key
        // fell through to itself with the mod key's Cmd still applied — so
        // mod+shift+O was Cmd+Shift+O and mod+shift+U was Cmd+Shift+U, both app
        // shortcuts. Without these morphs shift merely stacks onto the arrow and
        // produces select-a-word-over instead.
        nav_word_right: nav_word_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LA(RIGHT)>, <&kp LG(LS(O))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        nav_word_left: nav_word_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LA(LEFT)>, <&kp LG(LS(U))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        nav_line: nav_line {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LG(RIGHT)>, <&kp LG(LEFT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // SELECT variants: same motions with shift held so they extend the selection
        sel_up: sel_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(UP)>, <&kp LS(PG_UP)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sel_down: sel_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(DOWN)>, <&kp LS(PG_DN)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sel_line: sel_line {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(LG(RIGHT))>, <&kp LS(LG(LEFT))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        // The "mod" thumb key: momentary NAV while held; releasing it always
        // clears sticky selection (like KC_MOVE on the old dactyl).
        nav_mod: nav_mod {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &mo NAV>
                , <&macro_pause_for_release>
                , <&macro_release &mo NAV>
                , <&macro_tap &tog_off SELECT>;
        };

        // NAV's TAB key: the macOS app switcher, held open.
        //
        // A plain `&kp LG(TAB)` cannot cycle. Cmd goes down and back up inside the
        // single keypress, so the switcher closes the moment the key is released
        // and repeated taps only bounce between the two most recent apps. The
        // switcher stays open for exactly as long as Cmd is held, which the old
        // QMK `LM(1, LGUI)` mod key did for free and this layer deliberately does
        // not (every NAV key applies its own Cmd so the arrow cluster can stay
        // unmodified).
        //
        // So this holds Cmd for as long as the key itself is held: tap it for a
        // straight Cmd+Tab to the last app, or keep holding to leave the switcher
        // up and pick a target with `mod`+J/L, which send bare arrows and move the
        // selection. Release to commit. The press and release are balanced, which
        // matters — ZMK counts explicit modifier registrations, so a macro that
        // presses Cmd more often than it releases it leaves Cmd stuck down.
        app_switch: app_switch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp TAB>
                , <&macro_pause_for_release>
                , <&macro_release &kp LGUI>;
        };

        sel_copy: sel_copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LG(C) &kp ESC &tog_off SELECT>;
        };

        sel_cut: sel_cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LG(X) &kp ESC &tog_off SELECT>;
        };

        sel_paste: sel_paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LG(V) &tog_off SELECT>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        sys_tri_layer {
            if-layers = <SYM NUM>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&kp ESC         &kp Q  &kp W         &kp E          &kp R     &kp T              &kp Y      &kp U  &kp I      &kp O    &kp P      &tog SCROLL
&kp TAB         &kp A  &kp S         &kp D          &kp F     &kp G              &kp H      &kp J  &kp K      &kp L    &kp SEMI   &kp SQT
&kp LGUI        &kp Z  &kp X         &kp C          &kp V     &kp B              &kp N      &kp M  &kp COMMA  &kp DOT  &kp SLASH  &mkp LCLK
&scroll_alt LALT SCROLL  &num_tab NUM 0  &mt LSHFT ENTER  &nav_mod  &mo SYM  &kp BSPC  &kp SPACE                           &rclk_ctrl LCTRL RCLK
            >;
        };

        nav_layer {
            label = "NAV";
            bindings = <
&kp LG(ESC)  &kp LG(Q)  &kp LG(W)  &kp LA(BSPC)  &kp LG(R)  &kp LG(T)                 &kp LG(Y)  &nav_word_left  &nav_up  &nav_word_right  &kp LG(P)    &kp LG(BSPC)
&app_switch  &kp LG(A)  &kp LG(S)  &kp LSHFT     &kp LG(F)  &kp LG(G)                 &nav_line  &nav_left     &nav_down  &nav_right     &kp LG(SEMI)   &kp LG(SQT)
&trans       &kp LG(Z)  &kp LG(X)  &kp LG(C)     &kp LG(V)  &kp LG(B)                 &kp LG(N)  &kp LG(LBKT)  &kp LG(RBKT)  &kp LG(DOT)  &kp LG(SLASH)  &trans
&trans       &kp LG(TAB)  &trans   &trans        &trans                &kp LG(BSPC)   &tog_on SELECT                                                    &trans
            >;
        };

        select_layer {
            label = "SEL";
            bindings = <
&trans  &trans  &trans    &trans     &trans     &trans            &trans     &kp LS(LA(LEFT))  &sel_up       &kp LS(LA(RIGHT))  &trans  &trans
&trans  &trans  &trans    &trans     &trans     &trans            &sel_line  &kp LS(LEFT)      &sel_down     &kp LS(RIGHT)      &trans  &trans
&trans  &trans  &sel_cut  &sel_copy  &sel_paste &trans            &trans     &trans            &trans        &trans             &trans  &trans
&trans  &trans  &trans    &trans     &trans             &trans    &tog_off SELECT                                                       &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&trans  &kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PRCNT             &kp CARET  &kp AMPS   &kp STAR   &kp PLUS  &kp EQUAL  &trans
&trans  &kp TILDE  &kp GRAVE  &kp LBRC  &kp RBRC  &kp LBKT              &kp RBKT   &kp LPAR   &kp RPAR   &kp SQT   &kp DQT    &trans
&trans  &trans     &trans     &kp LBKT  &kp RBKT  &kp UNDER             &kp MINUS  &kp UNDER  &trans     &trans    &kp PIPE   &trans
&trans  &trans     &trans     &trans    &trans               &kp UNDER  &kp MINUS                                             &trans
            >;
        };

        // Nothing destructive belongs on this half. NUM outranks NAV (layer 4 vs
        // 1), so any press that catches both keys fires left-half NUM bindings in
        // place of everyday MOD combos — mod+C, mod+V, mod+W, mod+D. Bluetooth
        // profile select lived here briefly and cost a dead keyboard: it silently
        // drops all input and the selection persists across a power cycle. It is
        // on SYS instead, which needs two thumb keys held at once. NUM and MOD are
        // no longer adjacent thumb keys, which makes the collision rarer but not
        // impossible, and the cost of one is unchanged.
        number_layer {
            label = "NUM";
            bindings = <
&trans  &trans  &trans         &trans         &kp LC(R)      &trans                 &trans  &kp KP_N7  &kp KP_N8  &kp KP_N9  &trans  &trans
&trans  &trans  &kp LS(LA(S))  &kp LS(LA(D))  &kp LS(LA(F))  &trans                 &trans  &kp KP_N4  &kp KP_N5  &kp KP_N6  &trans  &trans
&trans  &trans  &trans         &kp LC(C)      &trans         &trans                 &trans  &kp KP_N1  &kp KP_N2  &kp KP_N3  &trans  &trans
&trans  &trans  &kp LS(ENTER)  &trans         &trans                 &kp LG(SPACE)  &kp KP_N0                                        &trans
            >;
        };

        system_layer {
            label = "SYS";
            bindings = <
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4       &kp F1  &kp F2   &kp F3   &kp F4   &kp F5      &kp F6
&none        &out OUT_USB  &out OUT_BLE  &out OUT_TOG    &none         &none              &kp F7  &kp F8   &kp F9   &kp F10  &kp F11     &kp F12
&bootloader  &sys_reset    &bt BT_CLR    &bt BT_CLR_ALL  &none         &none              &none   &none    &none    &none    &sys_reset  &bootloader
&trans       &trans        &trans        &trans        &trans                  &trans   &trans                                         &trans
            >;
        };

        // Inert: clicks are on dedicated keys, so the driver's automouse-layer is
        // 0 and this never activates. The node has to stay regardless — a layer's
        // index is its position among these children, and the driver hard-codes
        // SCROLL as 7 and SNIPE as 8.
        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans    &trans                                  &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans    &trans                                  &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans    &trans                                  &trans
            >;
        };
    };
};
