#include "keyball44.dtsi"
#include <input/processors.dtsi>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
	col-gpios
		= <&pro_micro 4 GPIO_ACTIVE_HIGH>
		, <&pro_micro 5 GPIO_ACTIVE_HIGH>
		, <&pro_micro 6 GPIO_ACTIVE_HIGH>
		, <&pro_micro 7 GPIO_ACTIVE_HIGH>
		, <&pro_micro 8 GPIO_ACTIVE_HIGH>
        , <&pro_micro 9 GPIO_ACTIVE_HIGH>
		;
};

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                <NRF_PSEL(SPIM_MOSI, 0, 10)>,
                <NRF_PSEL(SPIM_MISO, 0, 10)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                <NRF_PSEL(SPIM_MOSI, 0, 10)>,
                <NRF_PSEL(SPIM_MISO, 0, 10)>;
            low-power-enable;
        };
    };
};

&spi1 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "zmk,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	/* Layer indices must match config/keyball44.keymap:
	   6=MOUSE, 7=SCROLL, 1=NAV, 2=SELECT, 8=SNIPE.
	   NAV/SELECT in scroll-layers = ball scrolls while the mod key is held. */
	/* 0 disables the auto-mouse layer outright (the driver guards the whole
	   mechanism with #if AUTOMOUSE_LAYER > 0). Clicks are on dedicated keys
	   now, so nothing needs the ball to flip a layer — and this removes stray
	   clicks from brushing the ball while typing. Layer 6 still exists in the
	   keymap because SCROLL and SNIPE are indexed off it. */
	automouse-layer = <0>;
	scroll-layers = <7 1 2>;
	snipe-layers = <8>;
    };
};

/ {
  trackball_listener {
    compatible = "zmk,input-listener";
    device = <&trackball>;

    /* Fine pointer-speed trim, as <multiplier divisor>. CONFIG_PMW3610_CPI only
       moves in steps of 200, which is a 50% jump at this end of the range; this
       scales the reports instead. Unlike the driver's CPI_DIVIDOR it carries the
       remainder across reports (track-remainders), so slow movement survives.
       Effective speed = CPI * mul / div, here 400 * 7/8 = 350.
       Only REL_X/REL_Y are matched, so scroll speed is unaffected.
       This sets the slow-movement floor; long throws are handled by
       CONFIG_PMW3610_ACCELERATION_* rather than by raising this. */
    input-processors = <&zip_xy_scaler 7 8>;
  };
};
